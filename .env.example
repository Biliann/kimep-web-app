# Server-side only. Never prefix with VITE_ (that would ship the key to the browser).
NVIDIA_API_KEY=
# Primary model, e.g. google/gemma-4-31b-it. Comma-separated values are tried in order.
NIM_MODEL=
# Optional fallbacks tried when the primary is slow or down.
NIM_FALLBACK_MODELS=
# Optional tuning (milliseconds): NIM_FIRST_BYTE_MS=15000 NIM_FIRST_TOKEN_MS=12000 NIM_TOTAL_MS=55000 NIM_CHAIN_MS=50000
# Optional: extra allowed origins (comma-separated) and per-IP limit per 10 minutes
# ALLOWED_ORIGINS=https://your-domain.example
# CHAT_RATE_LIMIT=20
